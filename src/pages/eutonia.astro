---
import Layout from "../layouts/Layout.astro";
import { EUTONIA } from "../lib/site";
---

<Layout title={EUTONIA.title} description={EUTONIA.subtitle}>
  <article>
    <section class="relative overflow-hidden bg-stone-50 pt-32 pb-16 sm:pt-40 sm:pb-24">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -left-24 top-28 h-72 w-72 rounded-full border border-primary/15"></div>
        <div class="absolute -right-20 top-12 h-56 w-56 rounded-full bg-secondary/5"></div>
        <div class="absolute -right-8 top-40 h-24 w-24 rounded-full border border-accent/20"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <img
          src={EUTONIA.hero_image}
          alt={EUTONIA.hero_image_alt}
          class="mx-auto h-auto w-full max-w-xl animate-hero"
          width="736"
          height="480"
          fetchpriority="high"
        />
        <p class="mt-10 font-organic text-3xl text-secondary animate-hero-delay-1">
          {EUTONIA.eyebrow}
        </p>
        <h1 class="mt-2 text-4xl font-semibold text-balance text-stone-900 sm:text-6xl animate-hero">
          {EUTONIA.title}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-stone-600 sm:text-xl animate-hero-delay-2">
          {EUTONIA.intro}
        </p>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20 reveal-anim">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="font-organic text-4xl text-accent sm:text-5xl reveal-content">
          {EUTONIA.statement}
        </p>
      </div>
    </section>

    {EUTONIA.sections.map((section, index) => {
      const image_first = index % 2 === 0;
      return (
        <section
          class:list={[
            "relative overflow-hidden py-16 sm:py-24 reveal-anim",
            index % 2 === 0 ? "bg-stone-50" : "bg-white",
          ]}
        >
          <div aria-hidden="true" class="pointer-events-none absolute inset-0">
            <div
              class:list={[
                "absolute -right-24 top-10 h-64 w-64 rounded-full border",
                index % 2 === 0 ? "border-primary/15" : "border-secondary/15",
              ]}
            />
            <div
              class:list={[
                "absolute -right-6 top-36 h-28 w-28 rounded-full",
                index % 2 === 0 ? "bg-accent/5" : "bg-primary/5",
              ]}
            />
          </div>
          <div class="relative mx-auto grid max-w-5xl items-center gap-10 px-6 md:grid-cols-2 md:gap-16">
            <figure
              class:list={[
                "relative reveal-content",
                image_first ? "md:order-1" : "md:order-2",
              ]}
            >
              <div
                class:list={[
                  "overflow-hidden rounded-2xl border shadow-sm",
                  index % 2 === 0 ? "border-primary/15" : "border-secondary/15",
                ]}
              >
                <img
                  src={section.image}
                  alt={section.image_alt}
                  class:list={[
                    "h-full w-full object-cover",
                    section.image_aspect,
                  ]}
                  width={section.image_width}
                  height={section.image_height}
                  loading="lazy"
                />
              </div>
              <figcaption class="mt-3 text-sm font-medium tracking-wide text-stone-500 reveal-content">
                {section.image_caption}
              </figcaption>
            </figure>
            <div class:list={[image_first ? "md:order-2" : "md:order-1"]}>
              <p
                class:list={[
                  "font-organic text-3xl reveal-content",
                  index % 2 === 0 ? "text-primary" : "text-secondary",
                ]}
              >
                {section.eyebrow}
              </p>
              <h2 class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl reveal-content">
                {section.title}
              </h2>
              {section.paragraphs.map((paragraph) => (
                <p class="mt-4 text-base leading-relaxed text-pretty text-stone-600 reveal-content">
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="relative overflow-hidden bg-white py-16 sm:py-24 reveal-anim">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-organic text-3xl text-primary reveal-content">
            {EUTONIA.principles.eyebrow}
          </p>
          <h2 class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl reveal-content">
            {EUTONIA.principles.title}
          </h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {EUTONIA.principles.items.map((item) => (
            <article class="rounded-2xl border border-primary/10 bg-stone-50 p-6 text-center reveal-content">
              <span class="relative mx-auto flex h-20 w-20 items-center justify-center">
                <span class="absolute h-8 w-8 rounded-full bg-primary/10" />
                <img
                  src={item.icon}
                  alt=""
                  aria-hidden="true"
                  class="relative h-16 w-16 object-contain"
                  width="40"
                  height="40"
                  loading="lazy"
                />
              </span>
              <h3 class="mt-4 text-xl font-semibold text-stone-900 reveal-content">
                {item.title}
              </h3>
              <p class="mt-2 text-base leading-relaxed text-pretty text-stone-600 reveal-content">
                {item.text}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </article>

  <script>
    const revealTargets = document.querySelectorAll(".reveal-anim");

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      revealTargets.forEach((el) => {
        el.classList.add("visible");
        const contents = el.querySelectorAll(".reveal-content");
        contents.forEach((content) => {
          content.classList.add("opacity-100", "translate-y-0");
          content.classList.remove("opacity-0", "translate-y-4");
        });
      });
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              const contents = entry.target.querySelectorAll(".reveal-content");
              contents.forEach((content) => {
                content.classList.add("opacity-100", "translate-y-0");
                content.classList.remove("opacity-0", "translate-y-4");
              });
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      revealTargets.forEach((el) => observer.observe(el));
    }
  </script>
</Layout>
