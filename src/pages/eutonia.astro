---
import Layout from "../layouts/Layout.astro";
import { ACTIONS, CONTACT, EUTONIA } from "../lib/site";
---

<Layout title={EUTONIA.title} description={EUTONIA.subtitle}>
  <article>
    <section
      class="relative overflow-hidden bg-stone-50 pt-32 pb-16 sm:pt-40 sm:pb-24"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div
          class="absolute -left-24 top-28 h-72 w-72 rounded-full border border-primary/15"
        >
        </div>
        <div
          class="absolute -right-20 top-12 h-56 w-56 rounded-full bg-secondary/5"
        >
        </div>
        <div
          class="absolute -right-8 top-40 h-24 w-24 rounded-full border border-accent/20"
        >
        </div>
      </div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <img
          src={EUTONIA.hero_image}
          alt={EUTONIA.hero_image_alt}
          class="mx-auto h-auto w-full max-w-xl"
          width="736"
          height="480"
          fetchpriority="high"
        />
        <p class="mt-10 font-organic text-3xl text-secondary">
          {EUTONIA.eyebrow}
        </p>
        <h1
          class="mt-2 text-4xl font-semibold text-balance text-stone-900 sm:text-6xl"
        >
          {EUTONIA.title}
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-stone-600 sm:text-xl"
        >
          {EUTONIA.intro}
        </p>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="font-organic text-4xl text-accent sm:text-5xl">
          {EUTONIA.statement}
        </p>
      </div>
    </section>

    {
      EUTONIA.sections.map((section, index) => {
        const image_first = index % 2 === 0;
        return (
          <section
            class:list={[
              "relative overflow-hidden py-16 sm:py-24",
              index % 2 === 0 ? "bg-stone-50" : "bg-white",
            ]}
          >
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0"
            >
              <div
                class:list={[
                  "absolute -right-24 top-10 h-64 w-64 rounded-full border",
                  index % 2 === 0
                    ? "border-primary/15"
                    : "border-secondary/15",
                ]}
              />
              <div
                class:list={[
                  "absolute -right-6 top-36 h-28 w-28 rounded-full",
                  index % 2 === 0 ? "bg-accent/5" : "bg-primary/5",
                ]}
              />
            </div>
            <div
              class="relative mx-auto grid max-w-5xl items-center gap-10 px-6 md:grid-cols-2 md:gap-16"
            >
              <figure
                class:list={[
                  "relative",
                  image_first ? "md:order-1" : "md:order-2",
                ]}
              >
                <div
                  class:list={[
                    "overflow-hidden rounded-2xl border shadow-sm",
                    index % 2 === 0
                      ? "border-primary/15"
                      : "border-secondary/15",
                  ]}
                >
                  <img
                    src={section.image}
                    alt={section.image_alt}
                    class:list={[
                      "h-full w-full object-cover",
                      section.image_aspect,
                    ]}
                    width={section.image_width}
                    height={section.image_height}
                    loading="lazy"
                  />
                </div>
                <figcaption
                  class="mt-3 text-sm font-medium tracking-wide text-stone-500"
                >
                  {section.image_caption}
                </figcaption>
              </figure>
              <div
                class:list={[
                  image_first ? "md:order-2" : "md:order-1",
                ]}
              >
                <p
                  class:list={[
                    "font-organic text-3xl",
                    index % 2 === 0 ? "text-primary" : "text-secondary",
                  ]}
                >
                  {section.eyebrow}
                </p>
                <h2
                  class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl"
                >
                  {section.title}
                </h2>
                {section.paragraphs.map((paragraph) => (
                  <p class="mt-4 text-base leading-relaxed text-pretty text-stone-600">
                    {paragraph}
                  </p>
                ))}
              </div>
            </div>
          </section>
        );
      })
    }

    <section class="relative overflow-hidden bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="font-organic text-3xl text-primary">
            {EUTONIA.principles.eyebrow}
          </p>
          <h2
            class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl"
          >
            {EUTONIA.principles.title}
          </h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {
            EUTONIA.principles.items.map((item) => (
              <article
                class="rounded-2xl border border-primary/10 bg-stone-50 p-6 text-center"
              >
                <span class="relative mx-auto flex h-20 w-20 items-center justify-center">
                  <span class="absolute h-14 w-14 rounded-full bg-primary/10" />
                  <img
                    src={item.icon}
                    alt=""
                    aria-hidden="true"
                    class="relative h-16 w-16 object-contain"
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                </span>
                <h3 class="mt-4 text-xl font-semibold text-stone-900">
                  {item.title}
                </h3>
                <p class="mt-2 text-base leading-relaxed text-pretty text-stone-600">
                  {item.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="relative overflow-hidden bg-primary py-16 text-white sm:py-24"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div
          class="absolute -left-20 -top-16 h-64 w-64 rounded-full border border-white/15"
        >
        </div>
        <div
          class="absolute -right-16 bottom-0 h-72 w-72 rounded-full border border-white/10"
        >
        </div>
        <div
          class="absolute left-1/3 top-6 h-20 w-20 rounded-full bg-white/10"
        >
        </div>
      </div>
      <div class="relative mx-auto max-w-3xl px-6 text-center">
        <p class="font-organic text-3xl text-white/80">{EUTONIA.cta.eyebrow}</p>
        <h2 class="mt-2 text-3xl font-semibold text-balance sm:text-4xl">
          {EUTONIA.cta.title}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-pretty text-white/85">
          {EUTONIA.cta.text}
        </p>
        <div
          class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <a
            class="inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-primary transition hover:bg-stone-100"
            href="/#reservar"
          >
            {ACTIONS.primary.label}
          </a>
          <a
            class="inline-flex rounded-full border border-white/60 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
            href={CONTACT.whatsapp_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribime por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>
