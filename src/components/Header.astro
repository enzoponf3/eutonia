---
import { SITE, NAV_LINKS } from "../lib/site";

const pathname = Astro.url.pathname;

function active_label_for(path: string): string {
  if (path.includes("/eutonia")) return "Eutonía";
  if (path.includes("/sobre-mi")) return "Sobre mí";
  return "Inicio";
}

const active_label = active_label_for(pathname);
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-primary/10 bg-stone-50/90 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-6 py-4 sm:flex-row sm:justify-between"
  >
    <a href="/#inicio" class="shrink-0 flex" aria-label={SITE.name}>
      <img
        src="/icon.svg"
        alt={SITE.name}
        class="h-10 w-auto sm:h-12"
        width="320"
        height="260"
      /><img
        src="/logo.svg"
        alt={SITE.name}
        class="h-10 w-auto sm:h-12"
        width="920"
        height="260"
      />
    </a>
    <nav aria-label="Principal">
      <ul
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium text-stone-700"
      >
        {
          NAV_LINKS.map((link) => {
            const active = link.label === active_label;
            const is_primary = link.label === "Reservar";
            const base = link.external
              ? "inline-flex rounded-full border border-secondary px-4 py-2 " +
                "font-medium text-secondary transition hover:bg-secondary " +
                "hover:text-white"
              : is_primary
                ? "inline-flex rounded-full bg-primary px-4 py-2 font-semibold " +
                  "text-white shadow-sm shadow-primary/25 transition " +
                  "hover:bg-primary/90"
                : "transition hover:text-primary";
            return (
              <li>
                <a
                  class:list={[base, active && "font-semibold text-primary"]}
                  href={link.href}
                  aria-current={active ? "page" : undefined}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
