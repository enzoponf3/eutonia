---
import { LOCATION } from "../lib/site";
---

<section id="ubicacion" class="scroll-mt-28 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-organic text-3xl text-secondary">{LOCATION.eyebrow}</p>
      <h2
        class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl"
      >
        {LOCATION.title}
      </h2>
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div
        class="flex flex-col justify-center rounded-2xl border border-secondary/15 bg-stone-50 p-8 shadow-sm"
      >
        <p
          class="text-sm font-medium tracking-wide text-secondary uppercase"
        >
          {LOCATION.place}
        </p>
        <p class="mt-3 text-2xl leading-relaxed text-pretty text-stone-800">
          {LOCATION.address}
        </p>
        <a
          class="mt-6 inline-flex w-fit rounded-full bg-secondary px-5 py-3 text-sm font-medium text-white transition hover:opacity-90"
          href={LOCATION.directions_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Cómo llegar
        </a>
      </div>
      <div
        class="min-h-72 overflow-hidden rounded-2xl border border-secondary/15 shadow-sm"
      >
        <iframe
          title={`Mapa de ${LOCATION.place}`}
          src={LOCATION.map_url}
          class="h-full min-h-72 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
