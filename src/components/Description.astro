---
import { DESCRIPTION } from "../lib/site";
---

<section id="sobre-mi" class="scroll-mt-28 bg-stone-50 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-organic text-3xl text-primary">{DESCRIPTION.eyebrow}</p>
      <h2
        class="mt-2 text-3xl font-semibold text-balance text-stone-900 sm:text-4xl"
      >
        {DESCRIPTION.title}
      </h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        DESCRIPTION.items.map((item) => (
          <article
            class="flex flex-row items-start gap-4 rounded-2xl border border-primary/10 bg-white p-6 shadow-sm transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 md:flex-col md:items-center md:gap-0"
          >
            <span class="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-full md:mb-6">
              <span class="absolute h-14 w-14 rounded-full bg-primary/10"></span>
              <img
                src={item.icon}
                alt=""
                aria-hidden="true"
                class="h-30 w-30 object-contain"
                width="40"
                height="40"
              />
            </span>
            <div class="min-w-0 flex-1 md:w-full">
              <h3 class="text-xl font-semibold text-stone-900">{item.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-pretty text-stone-600">
                {item.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
