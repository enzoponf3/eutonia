---
import { PLANS } from "../lib/site";
---

<section id="reservar" class="scroll-mt-28 bg-stone-50 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-organic text-3xl text-primary">{PLANS.subtitle}</p>
      <h2 class="mt-2 text-4xl font-semibold text-balance text-stone-900 sm:text-5xl">{PLANS.title}</h2>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {PLANS.items.map((item,index) => (
        <article
          class={
            `flex flex-col rounded-2xl bg-white p-6 shadow-sm transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-105 motion-reduce:transition-none motion-reduce:hover:scale-100 ${
              index === 1 ? " border border-secondary"
              : index === 0 ? "border-2 border-accent"
              : "border-primary/10"
            }` 
          }
        >
          <div class="flex-1">
            <h3 class="text-xl font-semibold text-stone-900">{item.label}</h3>
            <p class="mt-2 text-base leading-relaxed text-pretty text-stone-600">{item.description}</p>
            <p class="mt-3 text-sm font-medium text-primary">{item.frequency}</p>
          </div>
          <a
            class="mt-4 inline-flex w-fit rounded-full bg-primary px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
            href={PLANS.reservarHref}
          >
            Reservar
          </a>
        </article>
      ))}
    </div>
  </div>
</section>