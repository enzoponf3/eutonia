---
import { GERDA } from "../lib/site";
---

<section id="gerda" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <figure
      class="gerda-reveal grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-center md:gap-16"
    >
    <div>

      <img
      src={GERDA.image}
        alt={GERDA.image_alt}
        class="gerda-img mx-auto w-full max-w-sm rounded-2xl object-cover shadow-sm md:col-start-1 md:row-span-2 -scale-x-100"
        width="330"
        height="330"
        loading="lazy"
      />
      <figcaption
      class="gerda-caption text-sm font-medium tracking-wide text-stone-500 uppercase md:col-start-2 mt-4 "
      >
      {GERDA.author}
        <span class="block font-normal tracking-normal text-stone-400 normal-case">
          {GERDA.role}
        </span>
      </figcaption>
    </div>
      <div class="gerda-text md:col-start-2">
        <p class="font-organic text-3xl text-primary">{GERDA.eyebrow}</p>
        <blockquote
          class="mt-4 text-2xl leading-relaxed text-pretty text-stone-800 sm:text-3xl"
        >
          <p>{GERDA.text}</p>
          <p>“{GERDA.quote}”</p>
        </blockquote>
      </div>
    </figure>
  </div>
</section>
