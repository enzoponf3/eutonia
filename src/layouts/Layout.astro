---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import FixedReserve from "../components/FixedReserve.astro";
import { SITE, build_title } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  image_alt?: string;
}

const {
  title = "",
  description = SITE.description,
  image = SITE.og_image,
  image_alt = SITE.og_image_alt,
} = Astro.props;

const page_title = build_title(title);
const canonical_path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(canonical_path, Astro.site ?? Astro.url).href;
const social_image = new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5c5f3f" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{page_title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={page_title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social_image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image_alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page_title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={social_image} />
    <meta name="twitter:image:alt" content={image_alt} />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-[100dvh] bg-stone-50 font-formal text-stone-900 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Contact />
    <FixedReserve />
  </body>
</html>
